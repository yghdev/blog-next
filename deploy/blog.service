[Unit]
Description=flechazo blog (Next.js SSR)
After=network-online.target
Wants=network-online.target
# 迁移前的 .backup 由 scripts/deploy.sh 负责，这里只管运行

[Service]
Type=simple
# C14：原先 User=root —— 应用有文件写入能力（上传）且渲染任意 HTML，
# root 会把提权半径放大到整机。改为专用用户（见 deploy/README 的安装步骤）。
User=blog
Group=blog
# 必须指向 current 软链（不是 /opt/blog 本体）。
# 2026-10-23 之前写的是 /opt/blog，与 scripts/deploy.sh 的软链式部署
# 完全脱节 —— 脚本建 releases/<戳> 并切 current，但服务始终读 /opt/blog 扁平文件，
# 于是部署「假装成功」。deploy.sh 现在会前置校验这项，不一致就拒绝部署。
WorkingDirectory=/opt/blog/current
Environment=NODE_ENV=production
Environment=PORT=8090
Environment=HOSTNAME=127.0.0.1
Environment=DATA_DIR=/var/lib/blog
Environment=UPLOAD_DIR=/var/www/blog-images
# 时区：展示层用 Intl 指定 Asia/Shanghai，这里固定 UTC 让日志与库内时间一致
Environment=TZ=UTC
# CSP 模式（D，2026-11-08）：enforce = 真正拦截；report-only = 只上报不拦。
# 默认值在 proxy.ts 里是 report-only，这里显式写 enforce 才是"生效"。
# 切换前必须先在隔离副本上验证：CSP_MODE=enforce bash smoke-remote.sh
# （2026-11-08 实测 32/32 通过，含后台编辑器/自动保存/发布/移动端）。
Environment=CSP_MODE=enforce
ExecStart=/usr/bin/node server.js
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# 内存硬上限：实测约 58MB，留足余量；P4 之后 SSR 开销进一步下降
MemoryHigh=300M
MemoryMax=400M
MemorySwapMax=200M

# OOM 时不要整机连坐；重启由 Restart= 负责
OOMPolicy=continue

# 加固
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536
ReadWritePaths=/var/lib/blog /var/www/blog-images

[Install]
WantedBy=multi-user.target
