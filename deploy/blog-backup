#!/usr/bin/env bash
#
# 博客备份：SQLite + 图片 -> 本地归档 -> 坚果云异地同步
#
# 与 Vaultwarden 备份的区别：博客不需要停机。
# SQLite 用 .backup 命令做在线一致性快照（WAL 模式下也安全），
# 所以这里不停 blog.service，也不影响线上访问。
#
# 用法：blog-backup [目标目录]
# 定时：/etc/cron.d/blog-backup 每日 04:00
set -euo pipefail

DEST="${1:-/root/blog-backups}"
DB=/var/lib/blog/blog.db
IMGDIR=/var/www/blog-images
REMOTE=jianguoyun:blog_backup
KEEP=14
STAMP=$(date +%Y%m%d-%H%M%S)

mkdir -p "$DEST"; chmod 700 "$DEST"
ARCHIVE="$DEST/blog-$STAMP.tar.gz"
TMP=$(mktemp -d); chmod 700 "$TMP"
trap 'rm -rf "$TMP"' EXIT

log() { printf '%s %s\n' "$(date '+%F %T')" "$*"; }

log "开始备份"

# 1. SQLite 在线快照（不停服务）
if [ ! -f "$DB" ]; then
  log "!! 数据库不存在：$DB"
  exit 1
fi
sqlite3 "$DB" ".backup '$TMP/blog.db'"

# 2. 完整性校验
CHK=$(sqlite3 "$TMP/blog.db" 'PRAGMA integrity_check;')
if [ "$CHK" != "ok" ]; then
  log "!! integrity_check 失败：$CHK"
  exit 1
fi

# 3. 业务数据自检（防止备份到空库）
POSTS=$(sqlite3 "$TMP/blog.db" "SELECT COUNT(*) FROM posts WHERE type='post' AND status='published';")
if [ "${POSTS:-0}" -lt 1 ]; then
  log "!! posts 数量异常：${POSTS:-0}"
  exit 1
fi
log "数据库 OK（已发布文章 $POSTS 篇）"

# 3.5 Artalk 评论库（P0-7，2026-11-07）
#
# 为什么单独一段：评论在独立容器 artalk 的 SQLite 里（/opt/artalk/data/artalk.db），
# **不在** blog.db；此前完全没进备份 = 评论数据只有单副本，容器或磁盘一挂就没了。
# Artalk 用 journal_mode=delete（非 WAL），.backup 仍然是在线一致性快照，不停容器。
#
# 失败**不中止**整个备份：博客数据是主线，评论是旁支。但必须在日志和 MANIFEST 里
# 留下"缺了"的痕迹 —— 静默跳过会让"备份成功"掩盖评论缺失，那是更坏的结果。
ARTALK_DB=/opt/artalk/data/artalk.db
ARTALK_STATUS="跳过（未找到 $ARTALK_DB）"
if [ -f "$ARTALK_DB" ]; then
  if sqlite3 "$ARTALK_DB" ".backup '$TMP/artalk.db'" 2>>/var/log/blog-backup.log; then
    ACHK=$(sqlite3 "$TMP/artalk.db" 'PRAGMA integrity_check;')
    if [ "$ACHK" = "ok" ]; then
      ACOUNT=$(sqlite3 "$TMP/artalk.db" "SELECT COUNT(*) FROM comments WHERE deleted_at IS NULL;")
      ARTALK_STATUS="artalk.db（integrity_check=ok，评论 ${ACOUNT} 条）"
      log "Artalk 评论库 OK（${ACOUNT} 条）"
    else
      rm -f "$TMP/artalk.db"
      ARTALK_STATUS="失败（integrity_check=${ACHK}）"
      log "!! Artalk 库 integrity_check 失败：${ACHK}"
    fi
  else
    ARTALK_STATUS="失败（.backup 出错，详见 /var/log/blog-backup.log）"
    log "!! Artalk 库快照失败"
  fi
else
  log "!! 未找到 Artalk 库：${ARTALK_DB}（已跳过，本次备份不含评论）"
fi

# 4. 打包（数据库 + 图片 + 清单）
mkdir -p "$TMP/images"
if [ -d "$IMGDIR" ]; then
  cp -a "$IMGDIR/." "$TMP/images/" 2>/dev/null || true
fi
# 视频单独计数并报警（2026-10-28 编辑器支持上传视频后新增）。
# 背景：本地目录里的视频会原样进每日备份并同步到坚果云。
# 配置了七牛图床时视频走 CDN 不落盘，这里为 0；
# 未配置时会落本机 —— 那条路径的代价必须让人看得见，而不是某天突然发现
# 备份从 12MB 涨到几个 GB。
VID_COUNT=$(find "$TMP/images" -type f \( -iname '*.mp4' -o -iname '*.webm' \) 2>/dev/null | wc -l)
VID_BYTES=$(find "$TMP/images" -type f \( -iname '*.mp4' -o -iname '*.webm' \) -printf '%s\n' 2>/dev/null | awk '{s+=$1} END {print s+0}')
VID_MB=$((VID_BYTES / 1024 / 1024))
if [ "$VID_MB" -ge 200 ]; then
  log "!! 本机视频已达 ${VID_MB}MB（${VID_COUNT} 个），备份与异地同步会随之变大。"
  log "!! 建议在 设置 → 图片存储 配置七牛，让视频改走 CDN。"
fi

cat > "$TMP/MANIFEST.txt" <<EOF
备份时间: $(date '+%F %T %Z')
数据库: blog.db（integrity_check=ok，已发布文章 $POSTS 篇）
评论: $ARTALK_STATUS
图片: $(find "$TMP/images" -type f 2>/dev/null | wc -l) 个文件
其中视频: ${VID_COUNT} 个，${VID_MB}MB（配置七牛图床后视频走 CDN，不计入此项）
来源: $DB + $IMGDIR + $ARTALK_DB
EOF

tar czf "$ARCHIVE" -C "$TMP" .
chmod 600 "$ARCHIVE"
log "归档完成：$ARCHIVE（$(du -h "$ARCHIVE" | cut -f1)）"

# 5. 同步到坚果云
#    坚果云要求父目录必须已存在，否则报 AncestorsNotFound(409)
rclone mkdir "$REMOTE" 2>>/var/log/blog-backup.log || true
if rclone copy "$ARCHIVE" "$REMOTE/" --no-traverse 2>>/var/log/blog-backup.log; then
  log "已同步到坚果云 $REMOTE"
else
  log "!! 坚果云同步失败（本地备份仍在 $ARCHIVE）"
fi

# 6. 两边都只保留最近 $KEEP 份
ls -1t "$DEST"/blog-*.tar.gz 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r f; do
  rm -f "$f"; log "清理本地旧备份：$(basename "$f")"
done

rclone lsf "$REMOTE/" --files-only 2>/dev/null | grep '^blog-.*\.tar\.gz$' | sort -r | \
  tail -n +$((KEEP + 1)) | while read -r f; do
    rclone deletefile "$REMOTE/$f" 2>/dev/null && log "清理远端旧备份：$f"
  done

log "备份结束"
